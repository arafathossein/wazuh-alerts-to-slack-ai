# ── Delivery ─────────────────────────────────────────────────
# Slack incoming webhook. Leave empty to print messages to the console instead.
SLACK_WEBHOOK_URL=
# Optional "Open in Wazuh" button target
WAZUH_DASHBOARD_URL=

# ── Security ─────────────────────────────────────────────────
# Shared secret; put the same value in <api_key> of the ossec.conf integration block.
SERVICE_API_KEY=
# true = replace internal (RFC 1918 etc.) IP addresses with [internal-ip] before summarising/sending
MASK_PRIVATE_IPS=false

# ── Summaries ────────────────────────────────────────────────
# Empty = built-in playbooks (no model, nothing leaves your network).
# Local model with Ollama:   LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_MODEL=llama3.1:8b
# OpenAI:                    LLM_BASE_URL=https://api.openai.com/v1  LLM_API_KEY=sk-...  LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Noise control ────────────────────────────────────────────
MIN_LEVEL=7
THROTTLE_WINDOW_SECONDS=600
ESCALATE_EVERY=50
DATA_DIR=data
